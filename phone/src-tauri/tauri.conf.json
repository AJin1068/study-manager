{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Manager Phone",
  "version": "0.1.0",
  "identifier": "app.studymanager.phone",
  "build": {
    "beforeDevCommand": "pnpm --dir .. exec vite --config phone/vite.config.ts",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm --dir .. exec vite build --config phone/vite.config.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Study Manager" }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "android": { "minSdkVersion": 26 }
  }
}
