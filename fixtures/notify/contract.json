{
  "comment": "Notification wire contract shared by the Edge Function (supabase/functions/_shared/channels.ts) and the desktop NotifyClient (src-tauri/src/remote/notify.rs). Nothing here names a subject or a plan: the text appears on a lock screen. The Telegram token below is a placeholder, not a credential.",
  "messages": {
    "test": "테스트 알림이에요. 잘 보이나요?",
    "missedTemplate": "{time}인데 아직 안 앉았어! 신호가 없어요."
  },
  "ntfy": {
    "defaultServer": "https://ntfy.sh",
    "title": "Study Manager",
    "requests": [
      {
        "name": "default server, test message",
        "server": "https://ntfy.sh",
        "topic": "abcdefghijklmnopqrstuvwx",
        "message": "테스트 알림이에요. 잘 보이나요?",
        "expect": {
          "method": "POST",
          "url": "https://ntfy.sh/abcdefghijklmnopqrstuvwx",
          "headers": { "title": "Study Manager" },
          "contentType": "text/plain; charset=utf-8",
          "body": "테스트 알림이에요. 잘 보이나요?"
        }
      },
      {
        "name": "own server with a trailing slash",
        "server": "https://ntfy.example.org/",
        "topic": "abcdefghijklmnopqrstuvwx",
        "message": "20:05인데 아직 안 앉았어! 신호가 없어요.",
        "expect": {
          "method": "POST",
          "url": "https://ntfy.example.org/abcdefghijklmnopqrstuvwx",
          "headers": { "title": "Study Manager" },
          "contentType": "text/plain; charset=utf-8",
          "body": "20:05인데 아직 안 앉았어! 신호가 없어요."
        }
      }
    ]
  },
  "telegram": {
    "api": "https://api.telegram.org",
    "requests": [
      {
        "name": "missed plan",
        "token": "100000:PLACEHOLDER_NOT_A_TOKEN",
        "chatId": "424242",
        "message": "20:05인데 아직 안 앉았어! 신호가 없어요.",
        "expect": {
          "method": "POST",
          "url": "https://api.telegram.org/bot100000:PLACEHOLDER_NOT_A_TOKEN/sendMessage",
          "headers": {},
          "contentType": "application/json",
          "body": { "chat_id": "424242", "text": "20:05인데 아직 안 앉았어! 신호가 없어요." }
        }
      }
    ]
  },
  "serverTest": {
    "comment": "Telegram has no token on the desktop, so the test button asks the Edge Function to send the test message to the signed-in user's own channel.",
    "route": "/functions/v1/missed-plan",
    "requestBody": { "action": "test" },
    "responseBody": { "ok": true }
  },
  "unsafeNtfyServers": [
    "http://ntfy.sh",
    "https://localhost",
    "https://127.0.0.1",
    "https://10.0.0.5",
    "https://192.168.0.7",
    "https://169.254.169.254",
    "https://[::1]",
    "https://user:pw@ntfy.sh",
    "https://ntfy.sh:8443",
    "https://intranet",
    "https://ntfy.sh/with/path?x=1",
    "ftp://ntfy.sh",
    "not a url"
  ],
  "safeNtfyServers": ["https://ntfy.sh", "https://ntfy.sh/", "https://ntfy.example.org"],
  "phoneApp": {
    "comment": "The phone_app channel (S5.7). The desktop mirrors the SAME ntfy topic and server it uses for the ntfy channel (notify_channels.ntfy_topic/ntfy_server); the Edge Function posts to it exactly as for ntfy, and the phone app polls it and shows a local notification. A phone_app row without a topic is invalid: the desktop mirrors such a configuration as 'none' and the server refuses to store it. The phone only ever shows the fixed phrases below; any other text arriving on the topic is shown as genericBody.",
    "channelRow": {
      "channel": "phone_app",
      "ntfy_topic": "abcdefghijklmnopqrstuvwx",
      "ntfy_server": "https://ntfy.sh",
      "telegram_chat_id": null,
      "missed_grace_min": 3,
      "utc_offset_min": 540
    },
    "rowWithoutTopic": "none",
    "poll": {
      "route": "{server}/{topic}/json?poll=1&since={cursor}",
      "requests": [
        {
          "name": "first poll, since a time",
          "server": "https://ntfy.sh",
          "topic": "abcdefghijklmnopqrstuvwx",
          "cursor": {
            "time": 1780000000
          },
          "expectUrl": "https://ntfy.sh/abcdefghijklmnopqrstuvwx/json?poll=1&since=1780000000"
        },
        {
          "name": "next poll, after a message id",
          "server": "https://ntfy.example.org/",
          "topic": "abcdefghijklmnopqrstuvwx",
          "cursor": {
            "id": "msgAbc123"
          },
          "expectUrl": "https://ntfy.example.org/abcdefghijklmnopqrstuvwx/json?poll=1&since=msgAbc123"
        }
      ],
      "response": [
        {
          "id": "o1",
          "time": 1780000001,
          "event": "open",
          "topic": "abcdefghijklmnopqrstuvwx"
        },
        {
          "id": "m1",
          "time": 1780000002,
          "event": "message",
          "topic": "abcdefghijklmnopqrstuvwx",
          "title": "Study Manager",
          "message": "20:05인데 아직 안 앉았어! 신호가 없어요."
        },
        {
          "id": "k1",
          "time": 1780000003,
          "event": "keepalive",
          "topic": "abcdefghijklmnopqrstuvwx"
        },
        {
          "id": "m2",
          "time": 1780000004,
          "event": "message",
          "topic": "abcdefghijklmnopqrstuvwx",
          "message": "테스트 알림이에요. 잘 보이나요?"
        },
        {
          "id": "m3",
          "time": 1780000005,
          "event": "message",
          "topic": "abcdefghijklmnopqrstuvwx",
          "message": "수학 문제집 3장 풀 시간이야"
        }
      ],
      "expectBodies": [
        "20:05인데 아직 안 앉았어! 신호가 없어요.",
        "테스트 알림이에요. 잘 보이나요?",
        "새 알림이 도착했어요."
      ],
      "expectCursorId": "m3"
    },
    "bodies": {
      "generic": "새 알림이 도착했어요.",
      "fixed": [
        "테스트 알림이에요. 잘 보이나요?",
        "00:00인데 아직 안 앉았어! 신호가 없어요.",
        "23:59인데 아직 안 앉았어! 신호가 없어요."
      ],
      "replacedByGeneric": [
        "수학 문제집 3장 풀 시간이야",
        "24:00인데 아직 안 앉았어! 신호가 없어요.",
        "8:05인데 아직 안 앉았어! 신호가 없어요.",
        "20:05인데 아직 안 앉았어! 신호가 없어요. 수학",
        "20:60인데 아직 안 앉았어! 신호가 없어요.",
        ""
      ]
    }
  }
}
